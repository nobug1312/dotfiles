{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/linux-rice/fastfetch/bonsai.txt",
    "color": {
      "1": "38;2;158;206;106",
      "2": "38;2;115;172;82",
      "3": "38;2;199;155;109",
      "4": "38;2;145;180;200"
    },
    "padding": {
      "left": 1,
      "right": 4,
      "top": 1
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "#cdd6f4"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}",
      "color": {
        "user": "#89b4fa"
      }
    },
    "break",
    {
      "type": "os",
      "key": "\udb84\udd05 os ",
      "keyColor": "#89b4fa"
    },
    {
      "type": "cpu",
      "key": "\uf4bc cpu",
      "keyColor": "#74c7ec"
    },
    {
      "type": "memory",
      "key": "\udb81\ude1a ram",
      "keyColor": "#94e2d5"
    },
    {
      "type": "shell",
      "key": "\uf489 sh ",
      "keyColor": "#cba6f7"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
