{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 8,
  "reload_style_on_change": true,

  "modules-left": [
    "custom/arch",
    "hyprland/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "custom/arch": {
    "format": "",
    "tooltip": false,
    "on-click": "vicinae toggle"
  },

  "modules-right": [
  "network",
  "bluetooth",
  "pulseaudio",
  "custom/monitor",
  "battery",
  "tray"
  ],

  "hyprland/workspaces": {
  "disable-scroll": true,
  "all-outputs": true,
  "format": "{icon}",
  "format-icons": {
    "active": "●",
    "default": "○"
  },
  "persistent-workspaces": {
    "*": 5
  }
},

  "clock": {
    "format": "{:%H:%M  ·  %a %d/%m}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "tooltip-format": "{ifname}: {ipaddr}",
    "interval": 5,
    "on-click": "nm-sidebar --toggle"
  },

  "bluetooth": {
    "format": "ᛒ",
    "format-connected": "ᛒ",
    "format-disabled": "ᛒ",
    "tooltip-format": "{controller_alias}\n{status}",
    "on-click": "blueman-manager"
  },

  "pulseaudio": {
  "format": "{icon}",
  "format-muted": "󰖁",
  "format-icons": {
    "default": ["󰕿", "󰖀", "󰕾"]
  },
  "scroll-step": 5,
  "on-click": "pavucontrol",
  "on-click-right": "pavucontrol"
},

  "custom/monitor": {
  "format": "󰍹",
  "tooltip": true,
  "tooltip-format": "Display settings",
  "on-click": "nwg-displays"
  },

  "battery": {
  "format": "{icon}",
  "format-charging": "󰂄",
  "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
  "states": {
    "warning": 25,
    "critical": 10
  },
  "tooltip": true
},

  "tray": {
    "icon-size": 14,
    "spacing": 6
  }
}
